<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Next Pivot | Business Development Management & Growth Support</title>
  <meta name="description" content="Next Pivot helps small to mid-sized businesses, founders, and community-focused organisations grow through practical business development, partnerships, and strategy." />

  <style>
    :root{
      --bg:#0b1220;
      --card:#101a2f;
      --muted:#93a4c7;
      --text:#eef3ff;
      --brand:#5eead4;
      --brand2:#60a5fa;
      --line:rgba(255,255,255,.10);
      --shadow: 0 16px 40px rgba(0,0,0,.35);
      --radius:18px;
      --max:1100px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      color:var(--text);
      background:
        radial-gradient(1200px 600px at 10% 0%, rgba(96,165,250,.20), transparent 60%),
        radial-gradient(900px 500px at 90% 10%, rgba(94,234,212,.18), transparent 55%),
        radial-gradient(1200px 900px at 60% 120%, rgba(96,165,250,.14), transparent 55%),
        var(--bg);
      line-height:1.5;
    }
    a{color:inherit; text-decoration:none}
    .wrap{max-width:var(--max); margin:0 auto; padding:0 20px}
    header{
      position:sticky; top:0; z-index:10;
      backdrop-filter: blur(10px);
      background: rgba(11,18,32,.75);
      border-bottom:1px solid var(--line);
    }
    .nav{
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 0;
      gap:16px;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      font-weight:800;
      letter-spacing:.2px;
    }
    .logo{
      width:34px; height:34px; border-radius:12px;
      background: linear-gradient(135deg, var(--brand), var(--brand2));
      box-shadow: 0 10px 22px rgba(96,165,250,.15);
      position:relative;
      overflow:hidden;
    }
    .logo:before{
      content:"";
      position:absolute; inset:-40%;
      background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.7), transparent 55%);
      transform: rotate(20deg);
      opacity:.45;
    }
    .navlinks{display:flex; gap:16px; align-items:center; flex-wrap:wrap}
    .navlinks a{
      color:var(--muted);
      font-weight:600;
      font-size:14px;
      padding:8px 10px;
      border-radius:12px;
    }
    .navlinks a:hover{background:rgba(255,255,255,.06); color:var(--text)}
    .cta{
      display:flex; gap:10px; align-items:center;
    }
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      padding:10px 14px;
      border-radius:14px;
      font-weight:700;
      border:1px solid var(--line);
      background: rgba(255,255,255,.04);
      color:var(--text);
      cursor:pointer;
      transition: transform .08s ease, background .2s ease, border-color .2s ease;
      font-size:14px;
      white-space:nowrap;
    }
    .btn:hover{background:rgba(255,255,255,.07); border-color:rgba(255,255,255,.18)}
    .btn:active{transform: translateY(1px)}
    .btn.primary{
      border:none;
      background: linear-gradient(135deg, var(--brand), var(--brand2));
      color:#06101f;
    }
    .btn.primary:hover{filter:saturate(1.05)}
    .hero{
      padding:72px 0 34px;
    }
    .grid{
      display:grid;
      grid-template-columns: 1.15fr .85fr;
      gap:22px;
      align-items:stretch;
    }
    @media (max-width: 900px){
      .grid{grid-template-columns:1fr}
      .hero{padding-top:46px}
    }
    .h-card{
      background:rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding:26px;
      position:relative;
      overflow:hidden;
    }
    .h-card:before{
      content:"";
      position:absolute; inset:-1px;
      background: radial-gradient(900px 450px at 20% 10%, rgba(94,234,212,.10), transparent 60%),
                  radial-gradient(900px 450px at 80% 20%, rgba(96,165,250,.10), transparent 60%);
      pointer-events:none;
    }
    .tag{
      display:inline-flex;
      gap:8px;
      align-items:center;
      padding:7px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      color:var(--muted);
      font-weight:700;
      font-size:13px;
      position:relative;
      z-index:1;
    }
    h1{
      margin:14px 0 12px;
      font-size:44px;
      line-height:1.08;
      letter-spacing:-.5px;
      position:relative;
      z-index:1;
    }
    @media (max-width: 520px){ h1{font-size:36px} }
    .lead{
      color:var(--muted);
      font-size:16px;
      margin:0 0 18px;
      position:relative;
      z-index:1;
      max-width:58ch;
    }
    .hero-actions{display:flex; gap:12px; flex-wrap:wrap; position:relative; z-index:1}
    .mini{
      margin-top:16px;
      display:flex; gap:10px; flex-wrap:wrap;
      position:relative; z-index:1;
    }
    .pill{
      padding:8px 10px;
      border-radius:999px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      color:var(--text);
      font-weight:700;
      font-size:13px;
    }
    .aside{
      display:flex; flex-direction:column; gap:14px;
    }
    .stat{
      background: rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius: var(--radius);
      padding:18px;
    }
    .stat h3{margin:0 0 6px; font-size:16px}
    .stat p{margin:0; color:var(--muted); font-size:14px}
    section{padding:34px 0}
    .section-title{
      display:flex; align-items:end; justify-content:space-between; gap:18px;
      margin-bottom:14px;
    }
    h2{
      margin:0;
      font-size:26px;
      letter-spacing:-.2px;
    }
    .sub{
      margin:0;
      color:var(--muted);
      max-width:70ch;
      font-size:14px;
    }
    .cards{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:14px;
    }
    @media (max-width: 900px){ .cards{grid-template-columns:1fr} }
    .card{
      background: rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius: var(--radius);
      padding:18px;
      min-height:160px;
    }
    .card h3{margin:0 0 8px; font-size:16px}
    .card p{margin:0; color:var(--muted); font-size:14px}
    .list{
      margin:10px 0 0;
      padding:0 0 0 18px;
      color:var(--muted);
      font-size:14px;
    }
    .list li{margin:8px 0}
    .banner{
      background: linear-gradient(135deg, rgba(94,234,212,.12), rgba(96,165,250,.12));
      border:1px solid rgba(255,255,255,.14);
      border-radius: var(--radius);
      padding:18px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      flex-wrap:wrap;
    }
    .banner strong{font-size:16px}
    .two{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
    }
    @media (max-width: 900px){ .two{grid-template-columns:1fr} }
    .steps{
      display:grid;
      gap:10px;
      margin-top:10px;
    }
    .step{
      display:flex; gap:12px; align-items:flex-start;
      padding:14px;
      border-radius: var(--radius);
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
    }
    .num{
      width:28px; height:28px; border-radius:10px;
      display:flex; align-items:center; justify-content:center;
      font-weight:900;
      background: rgba(255,255,255,.06);
      border:1px solid var(--line);
      flex:0 0 auto;
      color:var(--text);
    }
    .step h4{margin:0 0 4px; font-size:15px}
    .step p{margin:0; color:var(--muted); font-size:14px}
    .pricing{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:14px;
    }
    @media (max-width: 900px){ .pricing{grid-template-columns:1fr} }
    .price{
      background: rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius: var(--radius);
      padding:18px;
      position:relative;
      overflow:hidden;
    }
    .price.featured{
      border:1px solid rgba(94,234,212,.45);
      box-shadow: 0 18px 50px rgba(94,234,212,.08);
    }
    .badge{
      position:absolute; top:14px; right:14px;
      padding:6px 10px;
      border-radius:999px;
      background: rgba(94,234,212,.12);
      border:1px solid rgba(94,234,212,.35);
      color: var(--text);
      font-weight:800;
      font-size:12px;
    }
    .price h3{margin:0 0 4px}
    .price .who{margin:0 0 10px; color:var(--muted); font-size:14px}
    .price .from{
      font-size:22px;
      font-weight:900;
      letter-spacing:-.3px;
      margin:0 0 10px;
    }
    .fine{color:var(--muted); font-size:12px; margin:0}
    .faq{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
    }
    @media (max-width: 900px){ .faq{grid-template-columns:1fr} }
    details{
      border-radius: var(--radius);
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      padding:14px 14px 12px;
    }
    summary{
      cursor:pointer;
      font-weight:800;
      color:var(--text);
      list-style:none;
    }
    summary::-webkit-details-marker{display:none}
    details p{margin:10px 0 0; color:var(--muted); font-size:14px}
    .contact{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
      align-items:stretch;
    }
    @media (max-width: 900px){ .contact{grid-template-columns:1fr} }
    form{
      background: rgba(255,255,255,.03);
      border:1px solid var(--line);
      border-radius: var(--radius);
      padding:18px;
    }
    label{display:block; font-weight:800; font-size:13px; margin:12px 0 6px}
    input, textarea{
      width:100%;
      padding:12px 12px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(11,18,32,.55);
      color: var(--text);
      outline:none;
    }
    textarea{min-height:110px; resize:vertical}
    input:focus, textarea:focus{border-color: rgba(96,165,250,.55)}
    footer{
      border-top:1px solid var(--line);
      padding:26px 0 40px;
      color:var(--muted);
      font-size:13px;
    }
    .foot{
      display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap;
    }
    .small-links{display:flex; gap:12px; flex-wrap:wrap}
    .small-links a{color:var(--muted)}
    .small-links a:hover{color:var(--text)}
  </style>
</head>

<body>
  <header>
    <div class="wrap">
      <div class="nav">
        <a class="brand" href="#top" aria-label="Next Pivot home">
          <div class="logo" aria-hidden="true"></div>
          <div>Next Pivot</div>
        </a>

        <nav class="navlinks" aria-label="Primary navigation">
          <a href="#services">Services</a>
          <a href="#who">Who it’s for</a>
          <a href="#process">How it works</a>
          <a href="#packages">Packages</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="cta">
          <a class="btn" href="#contact">Enquire</a>
          <a class="btn primary" href="#contact" id="bookBtn">Book a discovery call</a>
        </div>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <div class="grid">
          <div class="h-card">
            <div class="tag">Business Development Management • Partnerships • Growth Support</div>
            <h1>Practical growth support for founders who don’t need fluff.</h1>
            <p class="lead">
              Next Pivot helps small to mid-sized businesses, start-ups, and community-focused organisations
              build a stronger pipeline, better partnerships, and clearer strategy — without needing a full-time hire.
            </p>

            <div class="hero-actions">
              <a class="btn primary" href="#contact">Start with a discovery call</a>
              <a class="btn" href="#services">See services</a>
            </div>

            <div class="mini" aria-label="Key outcomes">
              <span class="pill">More leads & warm opportunities</span>
              <span class="pill">Clear offers & messaging</span>
              <span class="pill">Partnerships that move the needle</span>
              <span class="pill">Systems you can actually run</span>
            </div>
          </div>

          <div class="aside">
            <div class="stat">
              <h3>Built for regional & non-metro business</h3>
              <p>Queensland focus, Australia-wide support. Local understanding, professional delivery.</p>
            </div>
            <div class="stat">
              <h3>Flexible support</h3>
              <p>Project-based, monthly retainers, or a quick reset session when you need clarity.</p>
            </div>
            <div class="stat">
              <h3>Warm + strategic tone</h3>
              <p>Human, community-driven, and structured — not corporate or pushy sales.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services">
      <div class="wrap">
        <div class="section-title">
          <h2>What Next Pivot does</h2>
          <p class="sub">Support you can feel in week one — clarity, momentum, and a plan you can execute.</p>
        </div>

        <div class="cards">
          <div class="card">
            <h3>Business development management</h3>
            <p>Hands-on support to grow your pipeline and create consistent opportunities.</p>
            <ul class="list">
              <li>Lead generation plans (warm + targeted)</li>
              <li>Outreach scripts and follow-up sequences</li>
              <li>CRM basics: tracking, stages, next steps</li>
            </ul>
          </div>

          <div class="card">
            <h3>Partnerships & relationship strategy</h3>
            <p>Build partnerships that are aligned and mutually valuable (not random collabs).</p>
            <ul class="list">
              <li>Partner identification + approach plan</li>
              <li>Value proposition and pitch messaging</li>
              <li>Activation ideas and co-marketing</li>
            </ul>
          </div>

          <div class="card">
            <h3>Growth strategy & offer clarity</h3>
            <p>Refine what you sell, who you sell it to, and how you communicate it.</p>
            <ul class="list">
              <li>Offer positioning and pricing support</li>
              <li>Simple messaging framework</li>
              <li>90-day action plan with priorities</li>
            </ul>
          </div>
        </div>

        <div style="height:14px"></div>

        <div class="banner">
          <div>
            <strong>Not sure what you need yet?</strong>
            <div style="color:var(--muted); font-size:14px; margin-top:4px">
              We start with your goals, your capacity, and what’s realistic right now — then build from there.
            </div>
          </div>
          <a class="btn primary" href="#contact">Book a discovery call</a>
        </div>
      </div>
    </section>

    <!-- WHO IT'S FOR -->
    <section id="who">
      <div class="wrap">
        <div class="section-title">
          <h2>Who this is for</h2>
          <p class="sub">If you’re doing everything and growth is stalling, you’re in the right place.</p>
        </div>

        <div class="two">
          <div class="card">
            <h3>Perfect if you’re…</h3>
            <ul class="list">
              <li>A founder who needs pipeline and partnerships, but not a full-time salesperson</li>
              <li>A small to mid-sized business ready to scale, but missing structure</li>
              <li>A regional or non-metro business wanting professional BD support</li>
              <li>A community-focused organisation needing stakeholder engagement and growth planning</li>
            </ul>
          </div>

          <div class="card">
            <h3>It’s especially helpful when…</h3>
            <ul class="list">
              <li>You’re relying on referrals and need consistency</li>
              <li>You’ve tried “marketing” but your offer/message isn’t landing</li>
              <li>You need someone to help you execute, not just advise</li>
              <li>You want a calm, clear plan without pressure tactics</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process">
      <div class="wrap">
        <div class="section-title">
          <h2>How it works</h2>
          <p class="sub">Simple, structured, and collaborative — you’ll always know what’s happening next.</p>
        </div>

        <div class="steps">
          <div class="step">
            <div class="num">1</div>
            <div>
              <h4>Discovery & goals</h4>
              <p>We clarify what growth means for you, what’s worked, and what’s getting in the way.</p>
            </div>
          </div>
          <div class="step">
            <div class="num">2</div>
            <div>
              <h4>Plan + priorities</h4>
              <p>You get a clear 30–90 day plan: pipeline actions, partnerships, and messaging improvements.</p>
            </div>
          </div>
          <div class="step">
            <div class="num">3</div>
            <div>
              <h4>Execution support</h4>
              <p>We implement together: outreach, follow-ups, partner conversations, and simple systems.</p>
            </div>
          </div>
          <div class="step">
            <div class="num">4</div>
            <div>
              <h4>Review & improve</h4>
              <p>We track what’s working, tighten the process, and build consistency (without burnout).</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PACKAGES -->
    <section id="packages">
      <div class="wrap">
        <div class="section-title">
          <h2>Ways to work together</h2>
          <p class="sub">Choose a starting point — you can always shift once we understand what you need.</p>
        </div>

        <div class="pricing">
          <div class="price">
            <h3>Clarity Call</h3>
            <p class="who">Best for: quick direction + next steps</p>
            <p class="from">From $ —</p>
            <ul class="list">
              <li>60–90 minute strategy session</li>
              <li>Offer + messaging check</li>
              <li>Priority actions for the next 2–4 weeks</li>
            </ul>
            <p class="fine">Pricing shown as “from” — tailor to scope and business size.</p>
          </div>

          <div class="price featured">
            <div class="badge">Most popular</div>
            <h3>Monthly Growth Support</h3>
            <p class="who">Best for: consistent pipeline + partnerships</p>
            <p class="from">From $ — / month</p>
            <ul class="list">
              <li>BD plan + weekly accountability</li>
              <li>Outreach scripts, follow-up templates</li>
              <li>Partnership approach + activation support</li>
              <li>Light CRM + simple reporting</li>
            </ul>
            <p class="fine">Ideal if you want momentum without hiring a full-time role.</p>
          </div>

          <div class="price">
            <h3>Project Sprint</h3>
            <p class="who">Best for: a specific goal or launch</p>
            <p class="from">From $ —</p>
            <ul class="list">
              <li>2–6 week sprint with clear outcomes</li>
              <li>Partnership campaign or pipeline build</li>
              <li>Go-to-market planning and execution support</li>
            </ul>
            <p class="fine">Great for new offers, new regions, or a fresh reset.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <div class="wrap">
        <div class="section-title">
          <h2>FAQ</h2>
          <p class="sub">Quick answers to common questions.</p>
        </div>

        <div class="faq">
          <details>
            <summary>Do you work with businesses outside Queensland?</summary>
            <p>Yes. There’s a strong regional and Queensland focus, but support is available Australia-wide.</p>
          </details>

          <details>
            <summary>Is this sales training?</summary>
            <p>Not in the traditional sense. This is practical business development support: strategy, pipeline, partnerships, messaging, and simple systems you can execute.</p>
          </details>

          <details>
            <summary>Do you do the work, or just advise?</summary>
            <p>Both. Depending on the package, you’ll get a clear plan plus hands-on implementation support (templates, outreach structure, partnership approach, and accountability).</p>
          </details>

          <details>
            <summary>What if I’m not ready for a monthly retainer?</summary>
            <p>Start with a Clarity Call. It’s a low-pressure way to get direction and decide your next step.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact">
      <div class="wrap">
        <div class="section-title">
          <h2>Let’s talk</h2>
          <p class="sub">Send an enquiry and I’ll get back to you with the next best step.</p>
        </div>

        <div class="contact">
          <div class="card">
            <h3>Contact details</h3>
            <p style="color:var(--muted); margin-top:0">
              Add your email, phone, and booking link here.
              If you have Calendly, you can link the “Book a discovery call” buttons to it.
            </p>

            <div style="margin-top:12px; border-top:1px solid var(--line); padding-top:12px">
              <p style="margin:0 0 8px"><strong>Email:</strong> hello@nextpivot.com.au</p>
              <p style="margin:0 0 8px"><strong>Location:</strong> Queensland (support Australia-wide)</p>
              <p style="margin:0"><strong>Availability:</strong> Project-based + monthly support</p>
            </div>

            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap">
              <a class="btn primary" href="#" onclick="alert('Add your Calendly/booking link here.'); return false;">Book a discovery call</a>
              <a class="btn" href="#services">Explore services</a>
            </div>
          </div>

          <form onsubmit="return handleSubmit(event)">
            <h3 style="margin:0 0 6px">Enquiry form</h3>
            <p style="margin:0; color:var(--muted); font-size:14px">
              This demo form doesn’t send emails yet — your developer can connect it to Formspree, Netlify Forms, or your CRM.
            </p>

            <label for="name">Name</label>
            <input id="name" name="name" placeholder="Your name" required />

            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" required />

            <label for="business">Business / Organisation</label>
            <input id="business" name="business" placeholder="Optional" />

            <label for="message">What do you need help with?</label>
            <textarea id="message" name="message" placeholder="A few lines is perfect." required></textarea>

            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap; align-items:center">
              <button class="btn primary" type="submit">Send enquiry</button>
              <span style="color:var(--muted); font-size:12px">Typically reply within 1–2 business days.</span>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="wrap">
        <div class="foot">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px">
              <div class="logo" aria-hidden="true" style="width:28px; height:28px; border-radius:10px"></div>
              <strong>Next Pivot</strong>
